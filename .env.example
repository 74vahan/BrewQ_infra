# Copy to .env (never commit .env). Values are empty on purpose (VibeCode rule 9).
#
# Production/dev on the server: /srv/brewq/.env is written once by the bootstrap in
# BrewQ_image; docker compose builds DATABASE_URL for the api container from MYSQL_*.

# --- MySQL (used by compose: db service and DATABASE_URL of api) ---
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Backend (app/backend, read by app.core.config) ---
# SQLAlchemy URL, e.g. mysql+pymysql://USER:PASSWORD@HOST:3306/DB?charset=utf8mb4
# Local run without compose: put it into app/backend/.env.
# Integration tests: TEST_DATABASE_URL (or DATABASE_URL); the database name must end with _test.
DATABASE_URL=
TEST_DATABASE_URL=
BARISTA_PASSWORD=
# at least 32 characters
BARISTA_TOKEN_SECRET=
BARISTA_TOKEN_TTL_HOURS=
# true/false; the api container sets them to true
MIGRATE_ON_START=
SEED_ON_START=
# true only in dev: FastAPI serves /media (nginx does it on the server)
SERVE_MEDIA=
MEDIA_DIR=
# true exposes /api/docs and /api/openapi.json (keep empty/false in production)
ENABLE_DOCS=
LOG_LEVEL=

# --- Used by compose / nginx / CI, not by the backend code ---
BACKEND_PORT=
PUBLIC_BASE_URL=
