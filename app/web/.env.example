# Dev-only switches read by Vite (src/api/index.ts). No secrets here.
# Use the in-memory fake data layer in `npm run dev` (default: true).
# Set to false to talk to the real backend through the dev proxy.
VITE_USE_FAKE_API=
# Optional: password the fake login accepts. Empty = any non-empty password.
VITE_FAKE_API_PASSWORD=
# Optional: where the dev proxy forwards /api and /media (default http://127.0.0.1:8081).
VITE_API_TARGET=
